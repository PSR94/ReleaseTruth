# Local API defaults to SQLite when this is unset.
# Docker Compose uses PostgreSQL automatically.
RELEASETRUTH_DATABASE_URL=sqlite+pysqlite:///./.releasetruth/releasetruth.db
RELEASETRUTH_CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# GitHub webhook ingestion is off by default. Enable it only with a secret in production.
RELEASETRUTH_GITHUB_WEBHOOK_ENABLED=false
RELEASETRUTH_GITHUB_WEBHOOK_SECRET=
# Deliberately insecure local-only escape hatch. Never enable in an exposed deployment.
RELEASETRUTH_GITHUB_WEBHOOK_ALLOW_UNSIGNED_DEV=false

# Server-side dashboard API endpoint.
RELEASETRUTH_API_URL=http://127.0.0.1:8000
